# ==============================================================================
# DataFlow AI Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env OR ANY FILE CONTAINING REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Storage Paths
# ------------------------------------------------------------------------------
# Project paths are resolved from the repository root unless overridden.
DATAFLOW_PROJECT_ROOT=.
DATAFLOW_DATA_DIR=data
DATAFLOW_DATABASE_PATH=data/warehouse/dataflow.duckdb
DATAFLOW_LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the FastAPI server
DATAFLOW_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (Server-side only — never hardcode in source)
# ------------------------------------------------------------------------------
# MotherDuck cloud warehouse (free tier — all storage and queries run in the cloud)
# Get your token at: https://motherduck.com → Settings → Service Tokens
# MOTHERDUCK_TOKEN=your-motherduck-service-token-here
# DATAFLOW_DATABASE_URL=md:dataflow_ai

# Optional external database connection string (e.g. PostgreSQL or MongoDB)
# DATAFLOW_DATABASE_URL=postgresql://user:password@localhost:5432/dataflow_ai
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/dataflow_ai

# ------------------------------------------------------------------------------
# 3. LLM & AI Assistant Adapters
# ------------------------------------------------------------------------------
# Local Ollama integration. Leave both unset unless Ollama is actually running;
# an implicit localhost provider causes slow failed retries on fresh installs.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# OpenAI-compatible integration (Server-side only — never expose key to frontend)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Google Gemini free tier (get a key at https://aistudio.google.com/app/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-flash-latest

# Keep AI latency predictable. The default makes at most one retry and avoids a
# second prose-synthesis request after every successful data query.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
AI_QUERY_TIMEOUT_SECONDS=8
AI_SYNTHESIZE_INSIGHTS=false

# ------------------------------------------------------------------------------
# 4. HTTP API Ingestion Authentication
# ------------------------------------------------------------------------------
# Optional default bearer/api token used when ingesting external JSON APIs
# INGESTION_API_KEY=your-api-token-here

# ------------------------------------------------------------------------------
# 5. Search Engine Optimization & Site Verification
# ------------------------------------------------------------------------------
# Google Search Console verification token (HTML tag content or file hash)
# GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# ==============================================================================
# PRODUCTION SERVICE REFERENCE TEMPLATES & SECURITY BOUNDARIES
# ==============================================================================
# The sections below document standard security policies for integrated services:
#
# CRITICAL FRONTEND / CLIENT-SIDE RULES:
# - React / Next.js exposes any env var prefixed with NEXT_PUBLIC_ or REACT_APP_ to browsers!
# - Never prefix sensitive credentials (secret keys, service roles, tokens) with public prefixes.
# - Streamlit dashboards run Python on the server, but never print or render credentials in the UI.

# ------------------------------------------------------------------------------
# 5. Supabase Configuration & RLS Warning
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
#
# IMPORTANT: The anon key can be used client-side ONLY IF Row Level Security (RLS)
# is enabled and enforced on EVERY table in your database. Without RLS, anyone with
# this key has full read/write access to your entire database.
# SUPABASE_ANON_KEY=your-anon-key-here
#
# DANGER: The service role key bypasses all Row Level Security policies.
# It has root admin privileges. It must NEVER appear in client-side code or browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 6. Stripe Payment Processing
# ------------------------------------------------------------------------------
# Publishable key: safe for browser / frontend (used to initialize Stripe Elements)
# STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
#
# Secret key: SERVER-SIDE ONLY. Full access to create charges, customers, and payouts.
# STRIPE_SECRET_KEY=sk_test_placeholder_key_here
#
# Webhook secret: SERVER-SIDE ONLY. Used to verify webhook signature authenticity.
# STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# ------------------------------------------------------------------------------
# 7. Authentication, OAuth & JWT
# ------------------------------------------------------------------------------
# JWT signing secret: SERVER-SIDE ONLY. Used to sign and verify session tokens.
# JWT_SECRET=your-256-bit-jwt-secret-placeholder
#
# OAuth credentials:
# OAUTH_CLIENT_ID=your-oauth-client-id
# OAUTH_CLIENT_SECRET=your-oauth-client-secret  # SERVER-SIDE ONLY

# ------------------------------------------------------------------------------
# 8. Cloud & Third-Party Service Keys (All Server-Side Only)
# ------------------------------------------------------------------------------
# AWS credentials
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1

# Firebase Admin SDK
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Communications (SendGrid / Twilio)
# SENDGRID_API_KEY=SG.placeholder_sendgrid_key_here
# TWILIO_ACCOUNT_SID=AC_placeholder_twilio_account_sid
# TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token


